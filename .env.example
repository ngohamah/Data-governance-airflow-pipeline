# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real SMTP credentials.

# Leave this at 50000 (the "airflow" user already baked into the base image).
# The airflow-init container overrides its entrypoint to run migrations
# directly, which skips the image's own arbitrary-UID setup — so a host UID
# here (e.g. from `id -u` on Linux) fails with "user has no username". 50000
# always works because that user already exists in the image.
AIRFLOW_UID=50000

# Admin email that receives Airflow failure alerts after retries are exhausted.
ADMIN_EMAIL=admin@example.com

# SMTP settings Airflow uses to actually send that email. Leave blank to skip
# email delivery (tasks still retry 3x/5min; the final alert just won't send).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=airflow-alerts@example.com
