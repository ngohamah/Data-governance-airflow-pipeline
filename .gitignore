# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Environment
.env

# Data (regenerable via src/data_generator.py --seed)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Airflow
plugins/*
!plugins/.gitkeep
airflow.cfg
airflow-webserver.pid
standalone_admin_password.txt

# Report deliverables (*.txt) ARE tracked — they're listed as brief
# deliverables. Only the supplementary plots (not a listed deliverable,
# purely regenerable) stay ignored.
reports/plots/*
!reports/plots/.gitkeep

# Editors / OS
.DS_Store
.vscode/
.idea/

# .md files
implementationmap.md
PII-Detection&Data.md